# Copy this file to .env and fill it in. Never commit .env.

PORT=5000
NODE_ENV=development

# REQUIRED in production (the server refuses to start without it): a long random string, 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created only if no admin with this email exists yet.
# ADMIN_PASSWORD is REQUIRED in production. Change it any time under Admin > Account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-use-10-plus-characters

# Local development database (a file). Ignored when TURSO_DATABASE_URL is set.
DB_PATH=./data/kitchen_world.db
UPLOAD_DIR=./public/uploads

# --- Free hosting (see DEPLOY-FREE.md) ---------------------------------------------------------
# Turso database (production). Leave empty in development to use the local file above.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary photo hosting (production). Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Without it, product photo uploads work in development only.
CLOUDINARY_URL=

# Websites allowed to call this API from a browser (comma-separated). SITE_URL is allowed automatically.
# Example: https://www.example.com,https://mm-kitchen.pages.dev
ALLOWED_ORIGINS=

# FRONTEND build setting: address of the API when the site and API are hosted separately,
# e.g. https://mm-kitchen-api.onrender.com  (leave empty when one server serves both)
VITE_API_URL=

# Public address of the website (used in sitemap.xml and robots.txt), e.g. https://mmkitchenworld.com
SITE_URL=

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
# (Read by the frontend at build time.)
VITE_GA_ID=
