# Copy this file to .env and fill it in. Never commit .env.

PORT=5000
NODE_ENV=development

# REQUIRED in production (the server refuses to start without it): a long random string, 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created only if no admin with this email exists yet.
# ADMIN_PASSWORD is REQUIRED in production. Change it any time under Admin > Account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-use-10-plus-characters

DB_PATH=./data/kitchen_world.db
UPLOAD_DIR=./public/uploads

# Public address of the website (used in sitemap.xml and robots.txt), e.g. https://mmkitchenworld.com
SITE_URL=

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
# (Read by the frontend at build time.)
VITE_GA_ID=
